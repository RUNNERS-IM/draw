{
  "name": "draw",
  "version": "2.6.1106",
  "private": true,
  "description": "Draw on your screen while you present, by RUNNERS",
  "homepage": "https://runners.im/draw",
  "license": "UNLICENSED",
  "author": {
    "name": "RUNNERS",
    "email": "sun@runners.im"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RUNNERS-IM/draw"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm check:account && electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint -c .oxlintrc.draw.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:account": "node src/runners-account/check.mjs --kit 0.1.30 && node src/main/runners/check.mjs --kit 0.1.30 && node scripts/check.mjs --kit 0.1.30",
    "check:locales": "node scripts/check-locales.mjs",
    "notices": "node scripts/third-party-notices.mjs Draw && node scripts/drawpen-notice.mjs",
    "dist": "pnpm build && electron-builder --config electron-builder.config.cjs"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.10",
    "i18next": "^26.7.1",
    "lazy-brush": "^2.0.2",
    "lodash": "^4.18.1",
    "lucide-react": "^1.69.0",
    "ntcjs": "^1.1.3",
    "perfect-freehand": "^1.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.1.12",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "43.8.6",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "sass": "^1.102.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.14.0",
  "appId": "im.runners.draw",
  "productName": "Draw"
}
